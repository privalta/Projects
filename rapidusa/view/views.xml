                    </sheet>
                </form>
            </field>
        </record>

        <record id="workers_view_tree" model="ir.ui.view">
            <field name="name">order.dispatched.view.tree</field>
            <field name="model">rapidusa.workers</field>
            <field name="arch" type="xml">
                <tree string="Workers">
                    <field name="employee_id"/>
                    <field name="worker_role_id"/>
                    <field name="rapid_attendances_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="rapidusa_worker_role_view_form" model="ir.ui.view">
            <field name="name">rapidusa_worker_role_view_form</field>
            <field name="model">rapidusa.worker_role</field>
            <field name="arch" type="xml">
                <form string="Worker Role">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                
                            </group>
                            <group>
                                <!-- <field name="fee"/> -->
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rapidusa_worker_role_view_tree" model="ir.ui.view">
            <field name="name">rapidusa_worker_role_view_tree</field>
            <field name="model">rapidusa.worker_role</field>
            <field name="arch" type="xml">
                <tree string="Worker Role">
                    <field name="name"/>
                    <!-- <field name="fee"/> -->
                </tree>
            </field>
        </record>

        <record id="rapidusa_worker_role_action" model="ir.actions.act_window">
            <field name="name">Worker Role</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rapidusa.worker_role</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="rapidusa_reason_cleaning_view_form" model="ir.ui.view">
            <field name="name">rapidusa_reason_cleaning_view_form</field>
            <field name="model">rapidusa.reason_cleaning</field>
            <field name="arch" type="xml">
                <form string="Reason for Cleaning">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="rapidusa_reason_cleaning_view_tree" model="ir.ui.view">
            <field name="name">rapidusa_reason_cleaning_view_tree</field>
            <field name="model">rapidusa.reason_cleaning</field>
            <field name="arch" type="xml">
                <tree string="Reason for Cleaning">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="rapidusa_reason_cleaning_action" model="ir.actions.act_window">
            <field name="name">Reason for Cleaning</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">rapidusa.reason_cleaning</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="rapidusa_dispatch_view_form" model="ir.ui.view">
            <field name="name">rapidusa_dispatch_view_form</field>
            <field name="model">rapidusa.dispatch</field>
            <field name="arch" type="xml">
                <form string="Distpatcher">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="employee_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
