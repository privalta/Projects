<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.actions.act_window" id="invoice_no_billed_wizard_action">
        <field name="name">Invoice no Billed</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rapidusa.invoice_no_billed_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="invoice_no_billed_wizard_form" model="ir.ui.view">
        <field name="name">Invoice no Billed</field>
        <field name="model">rapidusa.invoice_no_billed_wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice no Billed">
                <group>
                    <group>
                        <field name="start"/>
                        <field name="end"/>
                    </group>
                    <group>
                        <field name="detail"/>
                        <field name="acc_status"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Ver" class="oe_highlight"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>