<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Salary Rule -->
        <record id="hr_rule_role_driver" model="hr.salary.rule">
            <field name="name">Driver</field>
            <field name="sequence" eval="100" />
            <field name="code">Driver</field>
            <field name="category_id" ref="payroll.NET" />
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.Driver</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = worked_days.Driver.number_of_hours * 12</field>
        </record>

