            <field name="standard_price">0</field>
            <field name="type">service</field>
            <field name="default_code">CW_RC</field>
            <field name="categ_id" ref="product.cat_expense"/>
        </record>

        <record id="service_drive_allocation" model="product.product">
            <field name="name">Drive Allocation</field>
            <field name="list_price">0</field>
            <field name="standard_price">0</field>
            <field name="type">service</field>
            <field name="default_code">DR_A</field>
