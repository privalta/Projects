<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Expensable products -->
        <record id="service_vehicle_transfers" model="product.product">
            <field name="name">Vehicle Transfers</field>
            <field name="list_price">0</field>
            <field name="standard_price">0</field>
            <field name="type">service</field>
            <field name="default_code">VEH_T</field>
            <field name="categ_id" ref="product.cat_expense"/>
