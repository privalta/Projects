<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_rapid_driver" model="ir.sequence">
		   <field name="name">Vehicles Moved Sequence</field>
		   <field name="code">rapid_driver</field>
		   <field name="prefix">VM-</field>
		   <field name="padding">4</field>
		   <field name="company_id" ref="base.main_company"/>
	   </record>

		<record id="seq_invoice" model="ir.sequence">
		   <field name="name">Invoice Sequence</field>
		   <field name="code">invoice</field>
		   <field name="prefix">INV-</field>
		   <field name="padding">1</field>
		   <field name="company_id" ref="base.main_company"/>
	   </record>

	   <record id="seq_account_move" model="ir.sequence">
			<field name="name">Account Move Sequence</field>
			<field name="code">inv_account_move</field>
			<field name="prefix">INV-</field>
			<field name="padding">3</field>
			<field name="company_id" ref="base.main_company"/>
		</record>

	   <record id="seq_attendances" model="ir.sequence">
			<field name="name">Attendances Sequence</field>
			<field name="code">attendances</field>
			<field name="prefix">AT-</field>
			<field name="padding">4</field>
			<field name="company_id" ref="base.main_company"/>
		</record>

    </data>
</odoo>
