<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Salary Structure -->
        <record id="structure_rapid_usa" model="hr.payroll.structure">
            <field name="code">RAPID</field>
            <field name="name">Structure RapidUSA</field>
            <field
                eval="[(6, 0, [ref('rapidusa.hr_rule_role_driver'), 
                ref('rapidusa.hr_rule_role_lead_driver'),
                ref('rapidusa.hr_rule_role_regular_driver'),
                ref('rapidusa.hr_rule_role_senior_driver'),
                ref('rapidusa.hr_rule_role_lead_clean'),
                ref('rapidusa.hr_rule_role_assistant')])]"
                name="rule_ids"
            />
            <field name="company_id" ref="base.main_company" />
        </record>
    </data>
</odoo>